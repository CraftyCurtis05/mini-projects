{
  "name": "web-development-reference",
  "version": "1.0.0",
  "private": true,
  "description": "A personal web development reference built with HTML, CSS, and vanilla JavaScript.",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "lint": "eslint assets/js --ignore-pattern searchData.js",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "prettier": "^3.0.0"
  }
}
